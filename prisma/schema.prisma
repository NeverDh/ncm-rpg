generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Race {
  HUMAN
  ORCANO
  SYLVARI
  UMBREN
  DRAKARI
  VALTHERIN
}

enum CharacterClass {
  BARBARIAN
  MAGE
  ASSASSIN
}

enum CreationStep {
  START
  RACE
  CLASS
  NAME
  CONFIRM
  DONE
}

enum ItemType {
  WEAPON
  ARMOR
  CONSUMABLE
  MATERIAL
  QUEST
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum EquipmentSlot {
  WEAPON
  CHEST
  HELM
  BOOTS
  PANTS
  RING_1
  RING_2
  NECKLACE
  BELT
}

model TelegramAccount {
  id             String      @id @default(uuid())
  telegramUserId BigInt      @unique @map("telegram_user_id")
  username       String?
  createdAt      DateTime    @default(now()) @map("created_at")
  characters     Character[]

  @@map("telegram_accounts")
}

model Character {
  id        String @id @default(uuid())
  accountId String @map("telegram_account_id")
  account   TelegramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name             String?
  race             Race?
  characterClass   CharacterClass? @map("character_class")
  strength         Int             @default(0)
  dexterity        Int             @default(0)
  intelligence     Int             @default(0)
  vitality         Int             @default(0)
  resilience       Int             @default(0)
  vigorAttribute   Int             @default(0) @map("vigor_attribute")
  attributePointsRemaining Int     @default(0) @map("attribute_points_remaining")

  hp      Int @default(0)
  mana    Int @default(0)
  stamina Int @default(0)
  energy  Int @default(0) @map("energy")
  level   Int @default(1)

  creationStep CreationStep @default(START) @map("creation_step")
  isComplete   Boolean      @default(false) @map("is_complete")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventoryItems InventoryItem[]

  @@index([accountId, isComplete])
  @@map("characters")
}

model ItemDefinition {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  itemType ItemType @map("item_type")
  rarity ItemRarity @default(COMMON)

  wearSlot EquipmentSlot? @map("wear_slot")

  bonusStrength     Int @default(0) @map("bonus_strength")
  bonusDexterity    Int @default(0) @map("bonus_dexterity")
  bonusIntelligence Int @default(0) @map("bonus_intelligence")
  bonusVitality     Int @default(0) @map("bonus_vitality")
  bonusResilience   Int @default(0) @map("bonus_resilience")
  bonusVigor        Int @default(0) @map("bonus_vigor")

  effectHealHp      Int @default(0) @map("effect_heal_hp")
  effectRestoreMana Int @default(0) @map("effect_restore_mana")

  inventoryItems InventoryItem[]

  @@map("item_definitions")
}

model InventoryItem {
  id String @id @default(uuid())

  characterId String    @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  itemDefinitionId String         @map("item_definition_id")
  itemDefinition   ItemDefinition @relation(fields: [itemDefinitionId], references: [id], onDelete: Restrict)

  stackCount Int @default(1) @map("stack_count")

  /// Índice 0–19 na bolsa; nulo quando equipado.
  bagSlotIndex Int? @map("bag_slot_index")

  equippedSlot EquipmentSlot? @map("equipped_slot")

  @@index([characterId])
  @@index([characterId, bagSlotIndex])
  @@index([characterId, equippedSlot])
  @@map("inventory_items")
}
